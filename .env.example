# Optional. When set, real challan photos (uploaded by a driver or the owner) are read by Google Gemini.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional. Used only if no Gemini key is set.
ANTHROPIC_API_KEY=
# Public base URL used in the driver's WhatsApp link, for example https://challan-cash-razorpay.netlify.app
PUBLIC_URL=
PORT=8787
DATA_DIR=./data
